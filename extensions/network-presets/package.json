{
  "name": "network-presets",
  "title": "Network Presets",
  "description": "Switch network adapter settings between presets",
  "icon": "network-icon.png",
  "author": "rpsl",
  "categories": [
    "System"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "switch-network",
      "title": "Switch Network Preset",
      "description": "Apply a network preset to selected adapter",
      "mode": "view"
    },
    {
      "name": "manage-presets",
      "title": "Manage Network Presets",
      "description": "Add, edit, or delete network presets",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.64.0",
    "@raycast/utils": "^1.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@raycast/eslint-config": "^1.0.8",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^8.57.1",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.0.18"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "publish": "npx @raycast/api@latest publish"
  }
}
